{
  "match": {
    "language": "js-ts",
    "framework": "vite",
    "compiler": "swc",
    "react": true,
    "typescript": true,
    "packageManager": "npm",
    "existing": {
      "library": "lingui",
      "configured": true,
      "stringsWrapped": "yes"
    }
  },
  "ignore": ["candidateFiles", "localeSignals", "git", "sourceDir"]
}
